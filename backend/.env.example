# Copy to .env for local development and replace placeholders locally.
APP_ENV=development
APP_NAME=RecruitFlow API
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
COMPANY_TIMEZONE=Asia/Kolkata
NOTIFICATION_POLL_SECONDS=30
DOCUMENT_STORAGE_PATH=var/private-documents
DATABASE_URL=postgresql+psycopg://recruitflow:change-me@localhost:5432/recruitflow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication (generate a unique secret locally; never commit it)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
INVITATION_TOKEN_HOURS=48
PASSWORD_RESET_TOKEN_MINUTES=60
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_MIN_LENGTH=12

# Transactional email for employee invitations, password resets, and approved Offer links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
